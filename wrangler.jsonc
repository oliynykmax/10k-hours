{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "10k-hours",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "10k-hours.oliinyk.dev", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": { "enabled": true },
  "vars": {
    "BETTER_AUTH_URL": "https://10k-hours.oliinyk.dev",
    "GOOGLE_CLIENT_ID": "3922850272-0uctcn18urtqk1np1qsqp5h00sk5b9d2.apps.googleusercontent.com",
    "GITHUB_CLIENT_ID": "Ov23li5LyTOsVMrjdEzW",
  },
  "secrets": { "required": ["BETTER_AUTH_SECRET", "GOOGLE_CLIENT_SECRET", "GITHUB_CLIENT_SECRET"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "10k-hours-db", "database_id": "30589d68-5664-4f89-8ae5-1d1fb59f6983" },
  ],
}
